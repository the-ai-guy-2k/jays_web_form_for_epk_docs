# Copy to .env and set local values. Never commit .env.

# Port for local server
PORT=3000

# Unguessable path segment for Jay's intake URL (e.g. /i/<token>)
INTAKE_TOKEN=change-me-jay-intake-token

# Token required for TAIG review pages and JSON export
TAIG_REVIEW_TOKEN=change-me-taig-review-token

# Optional absolute path for SQLite file (default: ./data/submissions.sqlite)
# DATABASE_PATH=
